# Resume Forge Server - Environment Variables
# Copy this file to .env and fill in your values: cp .env.example .env

# Server port (frontend proxies to this port)
PORT=3001

# DeepSeek API - get your key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-coder
# Optional: override DeepSeek API base URL (defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Chroma vector database
# CHROMA_MODE: local (default, pure Node file storage, no extra process)
#              remote (connect to external Chroma HTTP server, requires deployment)
CHROMA_MODE=local
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION=resume-knowledge
# Only used when CHROMA_MODE=remote
# CHROMA_REMOTE_URL=http://localhost:8000

# Knowledge base root path (relative to server/)
KNOWLEDGE_BASE_PATH=./data/knowledge

# RAG tuning
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
